RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
# Trusted settlement relayer holds funds in transit. Worker-only key; never NEXT_PUBLIC_.
RELAYER_CONFIRM_TIMEOUT_MS=600000
# Mainnet signing disabled. Setting 1 is the owner's explicit decision, not an endorsement.
RELAYER_MAINNET_OK=0
NEARAI_API_KEY=
NEARAI_MODEL_TEXT=
NEARAI_MODEL_VISION=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
# live | mock (defaults to mock without an API key)
AI_MODE=
DATABASE_PATH=./data/tradewind.db
ONECLICK_BASE_URL=
ONECLICK_JWT=
# Dry by default. Real deposit addresses require mainnet + this flag + a user click.
ONECLICK_LIVE_QUOTES=0
# Local fake only; refused on mainnet. Set ONECLICK_BASE_URL=http://127.0.0.1:4444.
ONECLICK_SIMULATOR=0
SETTLEMENT_PATH=A
TELEGRAM_BOT_TOKEN=
# Default production Bot API. HTTP is allowed only for loopback harnesses.
TELEGRAM_API_ROOT=https://api.telegram.org
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
DATABASE_URL=
SESSION_SECRET=
