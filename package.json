{
  "name": "tradewind",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@tradewind/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "demo:local": "make build && cargo run --release -p tradewind --example demo_local",
    "test:contracts": "make test",
    "worker": "npm run start --workspace=@tradewind/worker"
  }
}
